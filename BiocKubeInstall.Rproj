Version: 1.0
ProjectId: 3b0a28df-12e6-43c8-8a86-80e39471a064

RestoreWorkspace: Default
SaveWorkspace: Default
AlwaysSaveHistory: Default

EnableCodeIndexing: Yes
UseSpacesForTab: Yes
NumSpacesForTab: 4
Encoding: UTF-8

RnwWeave: knitr
LaTeX: pdfLaTeX

BuildType: Package
PackageUseDevtools: Yes
PackageInstallArgs: --no-multiarch --with-keep.source --no-test-load --no-staged-install
PackageBuildArgs: --no-build-vignettes
PackageCheckArgs: --no-vignettes
PackageRoxygenize: rd,collate,namespace
